{
  "functions": {
    "api/video-gen.js": {
      "maxDuration": 30
    },
    "api/generate-image.js": {
      "maxDuration": 60
    },
    "api/upload-media.js": {
      "maxDuration": 60
    },
    "api/social-publish.js": {
      "maxDuration": 60
    },
    "api/cron-campaigns.js": {
      "maxDuration": 120
    },
    "api/cron-automations.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(self)" }
      ]
    },
    {
      "source": "/((?!form/|reservar/|cita/|p/|l/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sso-callback",
      "destination": "/sso-callback.html"
    },
    {
      "source": "/sso-callback/(.*)",
      "destination": "/sso-callback.html"
    },
    {
      "source": "/p/:token",
      "destination": "/proposal.html"
    },
    {
      "source": "/form/:token",
      "destination": "/form.html"
    },
    {
      "source": "/reservar/:token",
      "destination": "/reservar.html"
    },
    {
      "source": "/cita/:token",
      "destination": "/reservar.html"
    },
    {
      "source": "/l/:slug",
      "destination": "/api/l?slug=:slug"
    },
    {
      "source": "/agente/inmobiliarias",
      "destination": "/agente/inmobiliarias.html"
    },
    {
      "source": "/agente/constructoras",
      "destination": "/agente/constructoras.html"
    },
    {
      "source": "/agente/clinicas",
      "destination": "/agente/clinicas.html"
    },
    {
      "source": "/agente/educacion",
      "destination": "/agente/educacion.html"
    },
    {
      "source": "/agente/restaurantes",
      "destination": "/agente/restaurantes.html"
    },
    {
      "source": "/agente",
      "destination": "/agente/index.html"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-alerts",
      "schedule": "0 9,14,18 * * 1-5"
    },
    {
      "path": "/api/cron-reports",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron-monthly-reports",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron-automations",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron-knowledge",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/cron-campaigns",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron-trials",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron-retention",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-tasks",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron-programados",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-ventana",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-conectores",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/cron-integridad",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-recordatorios",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron-errores",
      "schedule": "15 * * * *"
    }
  ]
}